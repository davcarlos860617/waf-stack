# Copia este archivo como .env y ajusta los valores:   cp .env.example .env

# ---------------- Versiones ----------------
BUNKERWEB_VERSION=1.6.15
FLUENTBIT_VERSION=3.2
MARIADB_VERSION=11

TZ=America/Bogota

# ---------------- Sitio protegido ----------------
# Pruebas locales: app.localhost
# Servidor real:   el dominio que apunte a la IP del servidor (ej. miapp.duckdns.org)
APP_DOMAIN=app.localhost

# ---------------- Aplicación protegida ----------------
# A dónde reenvía BunkerWeb el tráfico ya filtrado. Elige UNA opción.
#
# Opción A - demo local (contenedor whoami de este compose):
COMPOSE_PROFILES=demo
APP_UPSTREAM=http://app:80
APP_UPSTREAM_HOST=
APP_UPSTREAM_SNI=no
#
# Opción B - aplicación externa (en cualquier lugar). Deja COMPOSE_PROFILES
# vacío para que no arranque la demo y usa uno de estos APP_UPSTREAM:
#   App Service / servicio con nombre propio y HTTPS:
#     COMPOSE_PROFILES=
#     APP_UPSTREAM=https://miapp.azurewebsites.net
#     APP_UPSTREAM_HOST=miapp.azurewebsites.net
#     APP_UPSTREAM_SNI=yes
#   Otro servidor por IP:          APP_UPSTREAM=http://10.0.0.5:8080
#   Esta misma VM, fuera de Docker: APP_UPSTREAM=http://host.docker.internal:3000
#
# Tiempo máximo esperando respuesta de la aplicación (opcional)
APP_UPSTREAM_TIMEOUT=60s

# ---------------- HTTPS ----------------
# Pruebas locales: certificado autofirmado
AUTO_LETS_ENCRYPT=no
GENERATE_SELF_SIGNED_SSL=yes
EMAIL_LETS_ENCRYPT=

# Servidor real con dominio público (descomenta y comenta lo de arriba):
# AUTO_LETS_ENCRYPT=yes
# GENERATE_SELF_SIGNED_SSL=no
# EMAIL_LETS_ENCRYPT=tu-correo@universidad.edu.co

# ---------------- WAF ----------------
# detect = solo registra los ataques (útil para ajustar falsos positivos)
# block  = registra y bloquea
SECURITY_MODE=block

# Segundos que dura el baneo automático por "mal comportamiento"
# (muchos 403/404 seguidos). En producción se suele usar 86400 (24 h).
BAD_BEHAVIOR_BAN_TIME=300

# ---------------- Interfaz web de BunkerWeb ----------------
# La clave debe tener minúscula, mayúscula, número y carácter especial.
# No uses el símbolo $ (Docker Compose lo interpreta como variable).
BW_UI_ADMIN_USER=admin
BW_UI_ADMIN_PASSWORD=Cambia-Esta-Clave-1

# Clave de la base de datos de BunkerWeb. Solo letras y números
# (va dentro de una URL de conexión; símbolos como @ : / la rompen).
BW_DB_PASSWORD=CambiaEstaClaveBD2026

# ---------------- Envío de logs a la reportería ----------------
# Dirección de Loki. Con los dos stacks en el mismo equipo, déjalo así.
# Si la reportería corre en otro servidor, pon su IP y abre ese puerto
# solo para la IP de este servidor.
LOKI_HOST=rep-loki
LOKI_PORT=3100
